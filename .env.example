# Copy to .env.local (gitignored) and fill in from Supabase > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. The public https:// address of the deployed site (no path), e.g. https://teamboard.example.com
# When set, production builds add the canonical link, the social-share URL and image, and a sitemap.xml.
VITE_SITE_URL=
